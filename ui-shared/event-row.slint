// EventRow (dt2-spec-components): a 52 dp time column (start over end, or ALL DAY), a 4 dp bar in the calendar colour,
// the title (16/600, a cake for a birthday) and the place line; past rows at 50 %. Month's agenda, search, the home
// agenda card and Clock's hero chip draw the same row.
import { Theme } from "@neoui/kit.slint";

export struct EventLine {
    // the app's index for the tap
    i: int,
    // "13:00", or "" for ALL DAY
    time: string,
    end: string,
    title: string,
    sub: string,
    color: color,
    cake: bool,
    past: bool,
}

export component EventRow inherits Rectangle {
    in property <EventLine> line;
    // the time column's own text instead of the times ("Mon 16" in search)
    in property <string> label;
    callback clicked();
    height: root.line.time == "" && root.label == "" ? 46 * Theme.dp : 50 * Theme.dp;
    opacity: root.line.past ? 0.5 : 1;
    background: touch.pressed ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        spacing: 12 * Theme.dp;
        VerticalLayout {
            width: 52 * Theme.dp;
            alignment: center;
            spacing: 1 * Theme.dp;
            if root.label != "": Text {
                text: root.label;
                font-size: 14 * Theme.dp;
                color: Theme.text-secondary;
            }
            if root.label == "" && root.line.time == "": Text {
                text: "ALL DAY";
                font-size: 12 * Theme.dp;
                font-weight: 600;
                color: Theme.text-secondary;
            }
            if root.label == "" && root.line.time != "": Text {
                text: root.line.time;
                font-size: 14 * Theme.dp;
                color: Theme.text-secondary;
            }
            if root.label == "" && root.line.time != "": Text {
                text: root.line.end;
                font-size: 12 * Theme.dp;
                color: Theme.text-dim;
            }
        }

        VerticalLayout {
            padding-top: 6 * Theme.dp;
            padding-bottom: 6 * Theme.dp;
            Rectangle {
                width: 4 * Theme.dp;
                border-radius: 2 * Theme.dp;
                background: root.line.color;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2 * Theme.dp;
            HorizontalLayout {
                spacing: 4 * Theme.dp;
                if root.line.cake: Image {
                    width: 16 * Theme.dp;
                    height: 16 * Theme.dp;
                    source: @image-url("icons/cake.svg");
                    colorize: root.line.color;
                }
                Text {
                    text: root.line.title;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            if root.line.sub != "": Text {
                text: root.line.sub;
                font-size: Theme.font-label;
                color: Theme.text-dim;
                overflow: elide;
            }
        }
    }
}
