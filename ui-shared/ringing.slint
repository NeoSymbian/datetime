// Ringing (dt2-ring-alarm, dt2-ring-timer; later NEOCAL's reminders): full screen, a 96 dp disc with two halos, the
// caption, the time in 96 dp digits, the title and a line under it, and two 60 dp buttons (Snooze / Dismiss, +1 min /
// Stop). The app plays the tone and decides what the buttons and Back do.
import { Theme, BigClock, Glyph } from "@neoui/kit.slint";

component RingButton inherits Rectangle {
    in property <string> text;
    in property <color> fill;
    in property <bool> snooze;
    callback clicked();
    height: 60 * Theme.dp;
    border-radius: self.height / 2;
    background: t.pressed ? self.fill.darker(20%) : self.fill;
    accessible-role: button;
    accessible-label: root.text;
    HorizontalLayout {
        alignment: center;
        spacing: 8 * Theme.dp;
        if root.snooze: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("icons/snooze.svg");
                size: 20 * Theme.dp;
                colorize: white;
            }
        }
        Text {
            text: root.text;
            color: white;
            font-size: 17 * Theme.dp;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component Ringing inherits Rectangle {
    // the disc's colour: the accent for an alarm, red for a timer
    in property <color> tint: Theme.accent;
    in property <image> icon;
    // "Alarm", "Timer · 5:00"
    in property <string> caption;
    in property <int> hours;
    in property <int> minutes;
    in property <bool> lead-zero: true;
    in property <string> title;
    in property <bool> title-tinted;
    in property <string> line;
    // the upper (grey) and the lower (tinted) button
    in property <string> first;
    in property <bool> first-snooze;
    in property <string> second;
    callback first-clicked();
    callback second-clicked();
    background: Theme.bg;
    // the screen under it takes no taps
    TouchArea { }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            spacing: 14 * Theme.dp;
            padding-left: 24 * Theme.dp;
            padding-right: 24 * Theme.dp;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 96 * Theme.dp;
                    height: self.width;
                    for inset[i] in [44, 22, 0]: Rectangle {
                        width: parent.width + 2 * inset * Theme.dp;
                        height: self.width;
                        border-radius: self.width / 2;
                        border-width: max(1px, Theme.dp / 2);
                        border-color: root.tint.with-alpha(i == 0 ? 0.1 : i == 1 ? 0.2 : 0.4);
                        background: i == 2 ? root.tint.with-alpha(0.15) : transparent;
                    }
                    Glyph {
                        source: root.icon;
                        size: 44 * Theme.dp;
                        colorize: root.tint;
                    }
                }
            }

            Rectangle {
                height: 18 * Theme.dp;
            }

            Text {
                text: root.caption.to-uppercase();
                color: Theme.text-dim;
                font-size: 11.7 * Theme.dp;
                font-weight: 600;
                letter-spacing: 0.78 * Theme.dp;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                BigClock {
                    hours: root.hours;
                    minutes: root.minutes;
                    lead-zero: root.lead-zero;
                    digit-h: 96 * Theme.dp;
                }
            }

            Text {
                text: root.title;
                color: root.title-tinted ? root.tint : Theme.text;
                font-size: 22 * Theme.dp;
                font-weight: 600;
                font-family: "DejaVu Sans";
                horizontal-alignment: center;
            }

            Text {
                text: root.line;
                color: Theme.text-dim;
                font-size: 15 * Theme.dp;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 10 * Theme.dp;
            padding-left: 24 * Theme.dp;
            padding-right: 24 * Theme.dp;
            padding-bottom: 26 * Theme.dp;
            RingButton {
                text: root.first;
                snooze: root.first-snooze;
                fill: Theme.dialog-button;
                clicked => {
                    root.first-clicked();
                }
            }

            RingButton {
                text: root.second;
                fill: root.tint;
                clicked => {
                    root.second-clicked();
                }
            }
        }
    }
}
