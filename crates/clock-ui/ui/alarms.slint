// SPDX-License-Identifier: GPL-3.0-only
// The Alarms tab (clk2-alarms, -empty): the next alarm in 64 dp digits, then one AlarmCard per alarm (tap to edit,
// the switch turns it on or off). The editor (clk2-alarm-edit, view "alarm"): the time (a tap opens the time sheet,
// clk2-alarm-time-sheet), the days, Once / Weekdays / Every day, a free-text label, the sound and the snooze. Alarm
// sound (clk2-alarm-sound, view "sound"). DTSRV keeps the alarms (DT1); every change goes there at once.
import { Theme, NeoList, BigClock, Glyph, Chip, TextField, Button } from "@neoui/kit.slint";
import { AlarmCard } from "@dt-shared/time-card.slint";
import { BigButton, Label, ValueRow, RadioRow } from "parts.slint";
import { ClockState } from "state.slint";

export component AlarmsPage inherits Rectangle {
    if ClockState.alarms.length == 0: VerticalLayout {
        alignment: center;
        spacing: 14 * Theme.dp;
        padding: 24 * Theme.dp;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 88 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                background: Theme.pill;
                Glyph {
                    source: @image-url("@neoui/icons/sys/alarm.svg");
                    size: 44 * Theme.dp;
                    colorize: Theme.text-dim;
                }
            }
        }

        Text {
            text: "No alarms";
            color: Theme.text;
            font-size: 20 * Theme.dp;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: "Alarms ring even when Clock is closed.";
            color: Theme.text-dim;
            font-size: 15 * Theme.dp;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: center;
            BigButton {
                text: "Add alarm";
                height: 44 * Theme.dp;
                width: self.preferred-width + 44 * Theme.dp;
                icon: @image-url("@neoui/icons/sys/add.svg");
                has-icon: true;
                clicked => {
                    ClockState.add();
                }
            }
        }
    }

    if ClockState.alarms.length > 0: NeoList {
        VerticalLayout {
            width: root.width;
            alignment: start;
            if ClockState.next-caption != "": VerticalLayout {
                spacing: 8 * Theme.dp;
                padding-top: 18 * Theme.dp;
                padding-bottom: 14 * Theme.dp;
                Label {
                    text: ClockState.next-caption.to-uppercase();
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: 6 * Theme.dp;
                    BigClock {
                        hours: ClockState.next-hours;
                        minutes: ClockState.next-minutes;
                        lead-zero: ClockState.h24;
                        digit-h: 64 * Theme.dp;
                    }

                    if ClockState.next-am-pm != "": VerticalLayout {
                        alignment: end;
                        Text {
                            text: ClockState.next-am-pm;
                            color: Theme.text-secondary;
                            font-size: 20 * Theme.dp;
                        }
                    }
                }

                Text {
                    text: ClockState.next-line;
                    color: Theme.text-secondary;
                    font-size: 15 * Theme.dp;
                    horizontal-alignment: center;
                    font-family: "DejaVu Sans";
                }
            }
            VerticalLayout {
                spacing: 10 * Theme.dp;
                padding-top: ClockState.next-caption != "" ? 0 : 12 * Theme.dp;
                padding-left: 12 * Theme.dp;
                padding-right: 12 * Theme.dp;
                padding-bottom: 12 * Theme.dp;
                for a in ClockState.alarms: AlarmCard {
                    hours: a.hours;
                    minutes: a.minutes;
                    lead-zero: ClockState.h24;
                    am-pm: a.am-pm;
                    label: a.label;
                    days: a.days;
                    once: a.once;
                    on: a.on;
                    clicked => {
                        ClockState.edit-alarm(a.id);
                    }
                    toggled(on) => {
                        ClockState.alarm-switched(a.id, on);
                    }
                }
            }
        }
    }
}

// a day of the week as a 38 dp circle: filled when the alarm rings on it
component DayButton inherits Rectangle {
    in property <string> letter;
    in property <bool> on;
    callback clicked();
    width: 38 * Theme.dp;
    height: self.width;
    border-radius: self.width / 2;
    background: root.on ? Theme.accent : t.pressed ? Theme.pressed : transparent;
    border-width: root.on ? 0 : max(1px, Theme.dp / 2);
    border-color: #ffffff26;
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.letter;
    Text {
        text: root.letter;
        color: root.on ? white : Theme.text-secondary;
        font-size: 15 * Theme.dp;
        font-weight: 600;
    }

    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component AlarmEditor inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        alignment: start;
        VerticalLayout {
            spacing: 6 * Theme.dp;
            padding-top: 18 * Theme.dp;
            padding-bottom: 14 * Theme.dp;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: time.preferred-width + 24 * Theme.dp;
                    height: time.preferred-height + 12 * Theme.dp;
                    border-radius: 14 * Theme.dp;
                    background: tt.pressed ? Theme.pressed : transparent;
                    accessible-role: button;
                    accessible-label: "Change time";
                    time := HorizontalLayout {
                        spacing: 6 * Theme.dp;
                        BigClock {
                            hours: ClockState.edit-hours;
                            minutes: ClockState.edit-minutes;
                            lead-zero: ClockState.h24;
                            digit-h: 72 * Theme.dp;
                        }

                        if ClockState.edit-am-pm != "": VerticalLayout {
                            alignment: end;
                            Text {
                                text: ClockState.edit-am-pm;
                                color: Theme.text-secondary;
                                font-size: 22 * Theme.dp;
                            }
                        }
                    }

                    tt := TouchArea {
                        clicked => {
                            ClockState.time-sheet = true;
                        }
                    }
                }
            }

            Text {
                text: ClockState.edit-when;
                color: Theme.text-dim;
                font-size: 14 * Theme.dp;
                horizontal-alignment: center;
            }
        }

        HorizontalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            alignment: space-between;
            for letter[i] in ["M", "T", "W", "T", "F", "S", "S"]: DayButton {
                letter: letter;
                on: ClockState.edit-days[i];
                clicked => {
                    ClockState.edit-day(i);
                }
            }
        }

        HorizontalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-top: 12 * Theme.dp;
            padding-bottom: 4 * Theme.dp;
            spacing: 8 * Theme.dp;
            alignment: start;
            for p[i] in ["Once", "Weekdays", "Every day"]: Chip {
                text: p;
                on: ClockState.edit-preset == i;
                toggled => {
                    ClockState.edit-preset-picked(i);
                }
            }
        }

        VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-top: 10 * Theme.dp;
            spacing: 6 * Theme.dp;
            Text {
                text: "Label";
                color: Theme.text-dim;
                font-size: 12.5 * Theme.dp;
            }

            TextField {
                text <=> ClockState.edit-label;
                placeholder: "Alarm";
            }
        }

        Rectangle {
            height: 8 * Theme.dp;
        }

        ValueRow {
            icon: @image-url("@neoui/icons/sys/tone.svg");
            caption: "Sound";
            value: ClockState.sound-name;
            clicked => {
                ClockState.open-sound();
            }
        }

        ValueRow {
            icon: @image-url("@dt-shared/icons/snooze.svg");
            caption: "Snooze";
            value: ClockState.snooze-text;
            clicked => {
                ClockState.snooze-sheet = true;
            }
        }

        if !ClockState.edit-new: HorizontalLayout {
            padding: 8 * Theme.dp;
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            Button {
                text: "Delete alarm";
                flat: true;
                tint: Theme.danger;
                icon: @image-url("@neoui/icons/sys/delete.svg");
                has-icon: true;
                clicked => {
                    ClockState.delete-alarm();
                }
            }
        }
    }
}

export component SoundView inherits Rectangle {
    background: Theme.bg;
    NeoList {
        VerticalLayout {
            width: root.width;
            alignment: start;
            for s[i] in ClockState.sounds: RadioRow {
                title: s;
                note: i < ClockState.sound-notes.length ? ClockState.sound-notes[i] : "";
                on: i == ClockState.sound-current;
                clicked => {
                    ClockState.sound-picked(i);
                }
            }
        }
    }
}
