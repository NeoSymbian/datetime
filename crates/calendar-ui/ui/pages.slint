// SPDX-License-Identifier: GPL-3.0-only
// The pages under a tab: the event (cal2-event-view), its form (cal2-event-edit), a to-do's (cal2-todo-edit), an
// anniversary's (cal2-anniversary-edit), a birthday (cal2-birthday-view), search, settings, Calendars
// (cal2-calendar-color), Add to Calendar (cal2-ics-import) and the reminder's Ringing (dt2-ring-event).
import { Theme, Glyph, Card, Button, TextField, Avatar, Chip, ListRow, BigClock } from "@neoui/kit.slint";
import { Cal, Detail } from "state.slint";
import {
    Caps, Divider, FieldLabel, FieldRow, DetailRow, SwitchRow, CalPill, RoundAction, Toggle
} from "parts.slint";

// a label and a text field
component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in-out property <string> text;
    in property <length> field-h: Theme.field-h;
    padding-left: 16 * Theme.dp;
    padding-right: 16 * Theme.dp;
    padding-top: 14 * Theme.dp;
    padding-bottom: 6 * Theme.dp;
    spacing: 8 * Theme.dp;
    FieldLabel {
        text: root.label;
    }

    TextField {
        height: root.field-h;
        text <=> root.text;
        placeholder: root.placeholder;
    }
}

// "16:00 – 17:00" in the display digits, or "All day"
component Times inherits HorizontalLayout {
    in property <bool> timed;
    in property <int> h0;
    in property <int> m0;
    in property <int> h1;
    in property <int> m1;
    in property <length> digit-h: 34 * Theme.dp;
    spacing: 12 * Theme.dp;
    alignment: start;
    if root.timed: BigClock {
        hours: root.h0;
        minutes: root.m0;
        digit-h: root.digit-h;
    }
    if root.timed: Text {
        text: "–";
        font-size: 18 * Theme.dp;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    if root.timed: BigClock {
        hours: root.h1;
        minutes: root.m1;
        digit-h: root.digit-h;
    }
    if !root.timed: Text {
        text: "All day";
        font-size: 22 * Theme.dp;
        color: Theme.text-secondary;
    }
}

export component EventPage inherits Flickable {
    content-height: box.preferred-height;
    box := VerticalLayout {
        width: parent.width;
        alignment: start;
        VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-top: 18 * Theme.dp;
            padding-bottom: 10 * Theme.dp;
            spacing: 10 * Theme.dp;
            HorizontalLayout {
                alignment: start;
                CalPill {
                    text: Cal.ev-cal;
                    tint: Cal.ev-color;
                }
            }

            Text {
                text: Cal.ev-title;
                font-size: 28 * Theme.dp;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }

            Times {
                timed: Cal.ev-timed;
                h0: Cal.ev-h0;
                m0: Cal.ev-m0;
                h1: Cal.ev-h1;
                m1: Cal.ev-m1;
            }

            Text {
                text: Cal.ev-when;
                font-size: 15 * Theme.dp;
                color: Theme.text-secondary;
            }
        }

        for d[i] in Cal.ev-rows: DetailRow {
            glyph: d.glyph;
            title: d.title;
            label: d.label;
            divider: i < Cal.ev-rows.length - 1;
        }
    }
}

export component EventForm inherits Flickable {
    content-height: box.preferred-height;
    box := VerticalLayout {
        width: parent.width;
        alignment: start;
        Field {
            label: "Title";
            placeholder: "Title";
            text <=> Cal.f-title;
        }

        SwitchRow {
            glyph: 9;
            title: "All day";
            on <=> Cal.f-all-day;
            toggled => {
                Cal.act("all-day", 0);
            }
        }

        FieldRow {
            glyph: 7;
            label: "Starts";
            value: Cal.f-starts;
            clicked => {
                Cal.act("starts", 0);
            }
        }

        FieldRow {
            label: "Ends";
            value: Cal.f-ends;
            clicked => {
                Cal.act("ends", 0);
            }
        }

        FieldRow {
            glyph: 1;
            label: "Repeat";
            value: Cal.f-repeat;
            clicked => {
                Cal.act("repeat", 0);
            }
        }

        FieldRow {
            glyph: 2;
            label: "Reminder";
            value: Cal.f-reminder;
            clicked => {
                Cal.act("reminder", 0);
            }
        }

        FieldRow {
            glyph: 5;
            label: "Calendar";
            value: Cal.f-cal;
            dot: Cal.f-cal-color;
            divider: false;
            clicked => {
                Cal.act("calendar", 0);
            }
        }

        Field {
            label: "Location";
            placeholder: "Add a place";
            text <=> Cal.f-place;
        }

        Field {
            label: "Notes";
            placeholder: "Add notes";
            field-h: 72 * Theme.dp;
            text <=> Cal.f-notes;
        }

        Rectangle {
            height: 16 * Theme.dp;
        }
    }
}

export component TodoForm inherits Flickable {
    content-height: box.preferred-height;
    box := VerticalLayout {
        width: parent.width;
        alignment: start;
        Field {
            label: "Title";
            placeholder: "Title";
            text <=> Cal.f-title;
        }

        VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-top: 10 * Theme.dp;
            padding-bottom: 10 * Theme.dp;
            spacing: 8 * Theme.dp;
            FieldLabel {
                text: "Priority";
            }

            Rectangle {
                height: 38 * Theme.dp;
                border-radius: self.height / 2;
                background: Theme.pill;
                border-width: 1px;
                border-color: Theme.card-border;
                HorizontalLayout {
                    padding: 3 * Theme.dp;
                    for p[i] in ["Low", "Normal", "High"]: Rectangle {
                        border-radius: self.height / 2;
                        background: Cal.f-priority == i ? #2f343b : transparent;
                        Text {
                            text: p;
                            font-size: 14.5 * Theme.dp;
                            font-weight: Cal.f-priority == i ? 600 : 500;
                            color: Cal.f-priority == i ? Theme.text : Theme.text-secondary;
                        }

                        TouchArea {
                            clicked => {
                                Cal.f-priority = i;
                            }
                        }
                    }
                }
            }
        }

        FieldRow {
            glyph: 5;
            label: "Due";
            value: Cal.f-due;
            clicked => {
                Cal.act("due", 0);
            }
        }

        FieldRow {
            glyph: 2;
            label: "Reminder";
            value: Cal.f-reminder;
            clicked => {
                Cal.act("reminder", 0);
            }
        }

        FieldRow {
            glyph: 8;
            label: "List";
            value: Cal.f-cal;
            clicked => {
                Cal.act("list", 0);
            }
        }

        Field {
            label: "Notes";
            placeholder: "Add notes";
            field-h: 72 * Theme.dp;
            text <=> Cal.f-notes;
        }
    }
}

